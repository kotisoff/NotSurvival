<container color="#40000060" size-func="unpack(gui.get_viewport())">
  <container gravity="center-center" size="400,200" color="#00000000" id="death_window">
    <label gravity="top-center" margin="0,10,0,0">You Died!</label>
    <label id="score" autoresize="true" markup="md">Score: [#FFFF00]0</label>
    <button text-align="center" color="#222222" hover-color="#333333" size="200,35" pos="100,75"
      onclick="respawn()">
      Respawn
    </button>
    <button id="pause_btn" text-align="center" color="#222222" hover-color="#333333" size="200,35"
      pos="100,120"
      onclick="pause()">
      Pause
    </button>
  </container>
</container>